// Per-tenant database (`tenant_<id>`). Source of truth: migrations/tenant/*.sql.
// tenant_id columns default to current_tenant_id() in the database, so app
// code never passes them; RLS rejects any row that names another tenant.

generator client {
  provider   = "prisma-client-js"
  output     = "../../node_modules/@il-generated/tenant"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

model TenantMeta {
  tenantId  String   @id @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tenant_meta")
}

model Asset {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId      String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  uploaderId    String    @map("uploader_id") @db.Uuid
  storageKey    String    @map("storage_key")
  filename      String
  mime          String
  bytes         BigInt    @default(0)
  width         Int?
  height        Int?
  sha256        String
  status        String    @default("uploading")
  title         String?
  description   String?
  altText       String?   @map("alt_text")
  exif          Json?
  takenAt       DateTime? @map("taken_at") @db.Timestamptz(6)
  blurhash      String?
  dominantColor String?   @map("dominant_color")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  variants    AssetVariant[]
  albums      AlbumAsset[]
  tags        AssetTag[]
  coverAlbums Album[]        @relation("AlbumCover")

  @@unique([tenantId, sha256])
  @@index([tenantId, createdAt])
  @@map("assets")
}

model AssetVariant {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  assetId    String   @map("asset_id") @db.Uuid
  kind       String
  format     String
  storageKey String   @map("storage_key")
  width      Int
  height     Int
  bytes      BigInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind, format])
  @@map("asset_variants")
}

model Album {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId     String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  title        String
  slug         String
  coverAssetId String?   @map("cover_asset_id") @db.Uuid
  visibility   String    @default("private")
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent     Album?       @relation("AlbumTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Album[]      @relation("AlbumTree")
  coverAsset Asset?       @relation("AlbumCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  assets     AlbumAsset[]

  @@unique([tenantId, slug])
  @@index([parentId])
  @@map("albums")
}

model AlbumAsset {
  albumId  String   @map("album_id") @db.Uuid
  assetId  String   @map("asset_id") @db.Uuid
  tenantId String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  position Float
  addedAt  DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([albumId, assetId])
  @@index([assetId])
  @@map("album_assets")
}

model Tag {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  assets AssetTag[]

  @@unique([tenantId, slug])
  @@map("tags")
}

model AssetTag {
  assetId  String @map("asset_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid
  tenantId String @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId])
  @@map("asset_tags")
}

model ShareLink {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId      String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  targetType    String    @map("target_type")
  targetId      String    @map("target_id") @db.Uuid
  token         String    @unique
  passwordHash  String?   @map("password_hash")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  allowDownload Boolean   @default(false) @map("allow_download")
  showExif      Boolean   @default(false) @map("show_exif")
  viewCount     Int       @default(0) @map("view_count")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@map("share_links")
}

model AuditLog {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  target    String?
  metadata  Json     @default("{}")
  ip        String?  @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("audit_log")
}

model Job {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  type      String
  payload   Json     @default("{}")
  status    String   @default("queued")
  attempts  Int      @default(0)
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("jobs")
}

model SchemaMigration {
  version   Int      @id
  name      String
  checksum  String
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}
